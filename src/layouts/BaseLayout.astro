---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

type Props = {
  title: string;
  description?: string;
  favicon?: string;
};

const { title, description = "", favicon } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {favicon && <link rel="icon" href={favicon} />}
    <script is:inline>
      (() => {
        const storageKey = "site-theme";
        const resolveTheme = () => {
          const storedTheme = localStorage.getItem(storageKey);
          const hour = new Date().getHours();
          return storedTheme || (hour >= 8 && hour < 21 ? "light" : "dark");
        };

        const applyTheme = (theme, root = document.documentElement) => {
          root.dataset.theme = theme;
        };

        window.__resolveSiteTheme = resolveTheme;
        window.__applySiteTheme = applyTheme;

        applyTheme(resolveTheme());

        document.addEventListener("astro:before-swap", (event) => {
          applyTheme(resolveTheme(), event.newDocument.documentElement);
        });

        document.addEventListener("astro:after-swap", () => {
          applyTheme(resolveTheme());
        });
      })();
    </script>
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        if (window.__mouseGlowBound) return;
        window.__mouseGlowBound = true;

        const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        if (!canHover) return;

        const root = document.documentElement;

        const showGlow = (x, y) => {
          root.style.setProperty("--cursor-glow-x", `${x}px`);
          root.style.setProperty("--cursor-glow-y", `${y}px`);
          root.style.setProperty("--cursor-glow-opacity", "1");
        };

        const hideGlow = () => {
          root.style.setProperty("--cursor-glow-opacity", "0");
        };

        window.addEventListener(
          "mousemove",
          (event) => {
            showGlow(event.clientX, event.clientY);
          },
          { passive: true }
        );

        window.addEventListener("mouseout", (event) => {
          if (!event.relatedTarget) {
            hideGlow();
          }
        });

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            hideGlow();
          }
        });

        document.addEventListener("astro:after-swap", hideGlow);
      })();
    </script>
  </body>
</html>
