---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "../config/site";

type Props = {
  title: string;
  description?: string;
  favicon?: string;
};

const { title, description = siteConfig.meta.description, favicon } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.meta.siteUrl);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(siteConfig.meta.ogImage, siteConfig.meta.siteUrl)} />
    <meta property="og:site_name" content={siteConfig.meta.title} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(siteConfig.meta.ogImage, siteConfig.meta.siteUrl)} />

    {favicon && <link rel="icon" href={favicon} />}

    <!-- JSON-LD 结构化数据 -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": siteConfig.intro.name,
      "url": siteConfig.meta.siteUrl,
      "image": new URL(siteConfig.intro.avatar, siteConfig.meta.siteUrl),
      "description": siteConfig.intro.bio,
      "sameAs": siteConfig.intro.contacts
        .filter(c => c.type === "link" && c.href.startsWith("http"))
        .map(c => c.href)
    })} />
    <script is:inline>
      (() => {
        const storageKey = "site-theme";
        const resolveTheme = () => {
          const storedTheme = localStorage.getItem(storageKey);
          const hour = new Date().getHours();
          return storedTheme || (hour >= 8 && hour < 21 ? "light" : "dark");
        };

        const applyTheme = (theme, root = document.documentElement) => {
          root.dataset.theme = theme;
        };

        window.__resolveSiteTheme = resolveTheme;
        window.__applySiteTheme = applyTheme;

        applyTheme(resolveTheme());

        document.addEventListener("astro:before-swap", (event) => {
          applyTheme(resolveTheme(), event.newDocument.documentElement);
        });

        document.addEventListener("astro:after-swap", () => {
          applyTheme(resolveTheme());
        });
      })();
    </script>
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        if (window.__mouseGlowBound) return;
        window.__mouseGlowBound = true;

        const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        if (!canHover) return;

        const root = document.documentElement;

        const showGlow = (x, y) => {
          root.style.setProperty("--cursor-glow-x", `${x}px`);
          root.style.setProperty("--cursor-glow-y", `${y}px`);
          root.style.setProperty("--cursor-glow-opacity", "1");
        };

        const hideGlow = () => {
          root.style.setProperty("--cursor-glow-opacity", "0");
        };

        window.addEventListener(
          "mousemove",
          (event) => {
            showGlow(event.clientX, event.clientY);
          },
          { passive: true }
        );

        window.addEventListener("mouseout", (event) => {
          if (!event.relatedTarget) {
            hideGlow();
          }
        });

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            hideGlow();
          }
        });

        document.addEventListener("astro:after-swap", hideGlow);
      })();
    </script>
  </body>
</html>
